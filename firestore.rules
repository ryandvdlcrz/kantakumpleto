rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admin flag: a document whose ID is the admin's UID. Created by hand in the console only.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // One score document per student. Students touch only their own; admin reads all.
    match /scores/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['username', 'name', 'section', 'createdAt']);
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
  }
}
